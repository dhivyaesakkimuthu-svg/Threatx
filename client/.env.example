# ThreatX React SOC Frontend - Environment Configuration
# Copy this file to .env and configure for your environment.

# Central Express API Gateway URL
# For local development with Vite dev proxy, leave blank or set to: http://localhost:3001
VITE_API_URL=http://localhost:3001

# Socket.IO Real-time Event Bus URL
VITE_SOCKET_URL=http://localhost:3001

# UI Configuration
VITE_APP_TITLE=ThreatX SOC Platform
VITE_DEMO_MODE=true
